name: dockercompose10560196182563871692
services:
  dotnet5crud:
    build:
      context: D:\Khalid old hdd\ASP.NETCORE5.0CRUD\ASP.NET CORE 5.0 CRUD\DotNet5Crud
      dockerfile: Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: DotNet5Crud
      target: base
    container_name: dot-net5-crud
    depends_on:
      dotnet5cruddb:
        condition: service_started
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      DB_HOST: dotnet5cruddb
      DB_NAME: CompanyDB
      DB_SA_PASSWORD: clover@123
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    image: dotnet5crud:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  ""'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      dotnet5crudnetwork: null
    ports:
      - mode: ingress
        target: 80
        published: "8087"
        protocol: tcp
      - mode: ingress
        target: 80
        protocol: tcp
    tty: true
    volumes:
      - type: bind
        source: D:\Khalid old hdd\ASP.NETCORE5.0CRUD\ASP.NET CORE 5.0 CRUD\DotNet5Crud
        target: /app
        bind: {}
      - type: bind
        source: D:\Khalid old hdd\ASP.NETCORE5.0CRUD\ASP.NET CORE 5.0 CRUD\DotNet5Crud
        target: /src
        bind: {}
      - type: bind
        source: C:\Users\khalid.ansari\vsdbg\vs2017u5
        target: /remote_debugger
        bind: {}
      - type: bind
        source: C:\Users\khalid.ansari\.nuget\packages
        target: /.nuget/packages
        read_only: true
        bind: {}
      - type: bind
        source: C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages
        target: /.nuget/fallbackpackages
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\khalid.ansari\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\khalid.ansari\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\khalid.ansari\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\khalid.ansari\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: D:\VS2022Install\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net8.0
        target: /VSTools
        read_only: true
        bind: {}
      - type: bind
        source: D:\VS2022Install\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind: {}
  dotnet5cruddb:
    container_name: dot-net5-crud-db
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: clover@123
    image: mcr.microsoft.com/mssql/server:2019-latest
    networks:
      dotnet5crudnetwork: null
    ports:
      - mode: ingress
        target: 1433
        published: "8080"
        protocol: tcp
networks:
  dotnet5crudnetwork:
    name: dockercompose10560196182563871692_dotnet5crudnetwork